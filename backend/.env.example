# ---------------------------------------------------------------------------
# LearnBot backend configuration
#
# 1. Copy this file to ".env"  (do NOT commit the real .env file).
# 2. Choose how answers are generated with MODEL_MODE (see below).
# ---------------------------------------------------------------------------

# --- How to generate answers -------------------------------------------------
# "local"  = run a small Hugging Face model on this computer.
#            No token and no inference quota. The model is downloaded once.
# "hosted" = call the Hugging Face Inference Providers API.
#            Needed for hosted mode: a Hugging Face token and a model id below.
#
# NOTE: Free hosted inference is not unlimited and can be unavailable or
# rate-limited. If hosted mode fails, switch MODEL_MODE to "local".
MODEL_MODE=local

# --- Local mode settings (used when MODEL_MODE=local) ------------------------
# Qwen2.5-0.5B-Instruct is small and fast. For better answers (larger download,
# slower on CPU) you can try: Qwen/Qwen2.5-1.5B-Instruct
LOCAL_MODEL_ID=Qwen/Qwen2.5-0.5B-Instruct
LOCAL_MAX_NEW_TOKENS=200

# --- Hosted mode settings (used when MODEL_MODE=hosted) ----------------------
# Create a free token at https://huggingface.co/settings/tokens
HUGGINGFACEHUB_API_TOKEN=your_huggingface_token_here
HUGGINGFACE_MODEL_ID=mistralai/Mistral-7B-Instruct-v0.3

# --- Optional settings (defaults are already used if you leave them out) -----

# Embedding model (runs locally, no token needed).
EMBEDDING_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2

# RAG settings.
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=3

# Folder where ChromaDB keeps its files.
VECTORSTORE_DIR=chroma_db
